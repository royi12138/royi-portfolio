# Keep the real API key only in your local ignored .env file or deployment environment settings.
# This legacy variable is also used as the key name for compatible providers such as Zhipu BigModel.
DASHSCOPE_API_KEY=
# Use the provider's OpenAI-compatible base URL; it must match the API Key.
# Zhipu BigModel: https://open.bigmodel.cn/api/paas/v4
# Alibaba DashScope (Beijing): https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# Optional; BigModel defaults to glm-4.6v when DASHSCOPE_BASE_URL points to open.bigmodel.cn.
BIGMODEL_VISION_MODEL=glm-4.6v
